server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Look the api host up through the container's own DNS, and again every few seconds.
  # By default nginx resolves a proxy host once, at start, and would keep sending
  # requests to the old address after the api container is recreated.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;

  # The API, on the same origin as the page, so the browser needs no CORS setup.
  location /api/ {
    # A variable here is what makes nginx use the resolver above. With no path after the
    # host, the request path is passed on unchanged.
    set $api_upstream ${API_URL};
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Vite puts a content hash in every asset file name, so these can be cached for good.
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Everything else is the single-page app. Unknown paths such as /competitors/acme-crm
  # get index.html and the router takes over. index.html itself is never cached, so a
  # new deploy is picked up on the next load.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
