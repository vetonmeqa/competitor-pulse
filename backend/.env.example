# Copy to .env for local development. Every value below is the built-in default,
# so the backend also runs with no .env at all.

DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
PORT=3000
LOG_LEVEL=info

# Data source
SOURCE_BASE_URL=http://localhost:4002
SOURCE_RATE_LIMIT_PER_SEC=5
SOURCE_TIMEOUT_MS=10000

# Scheduler
POLL_INTERVAL_SECONDS=900
POLL_MAX_IN_FLIGHT=50

# LLM. With nothing else set, this is the provided mock LLM on localhost:4001.
#   openai-compatible: the mock, OpenAI, Ollama and similar. Set LLM_BASE_URL, LLM_API_KEY, LLM_MODEL.
#   anthropic:         Claude through the Anthropic SDK. Set LLM_API_KEY (or ANTHROPIC_API_KEY);
#                      LLM_MODEL defaults to claude-opus-5-5. LLM_BASE_URL is ignored.
LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:4001/v1
# LLM_API_KEY=mock
# LLM_MODEL=mock-llm
LLM_TIMEOUT_MS=15000
LLM_DAILY_CAP=2000
LLM_MAX_ATTEMPTS=3
LLM_CONCURRENCY=2
# Changes summarised per LLM call (1-20). Needs a real model; keep 1 for the mock LLM.
LLM_BATCH_SIZE=1
SUMMARY_MAX_AGE_HOURS=48

RETENTION_DAYS=90
