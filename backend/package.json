{
  "name": "competitor-pulse-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env src/main-api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/main-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "drizzle-orm": "^0.45.4",
    "entities": "^9.0.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
