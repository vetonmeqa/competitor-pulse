# Settings for `docker compose up`. Copy to .env and change what you need.
# Every value here is the default, so the system also runs with no .env at all.

# --- Data source ---------------------------------------------------------------------
# Point this at your own instance to replace the bundled one. For an instance running on
# your machine (outside Docker), use http://host.docker.internal:<port>.
SOURCE_BASE_URL=http://listing-source:4002
SOURCE_RATE_LIMIT_PER_SEC=5
SOURCE_TIMEOUT_MS=10000

# --- Scheduler -----------------------------------------------------------------------
# How often each competitor is polled. Production would use 900 (15 minutes).
POLL_INTERVAL_SECONDS=30

# --- LLM -----------------------------------------------------------------------------
# openai-compatible: the bundled mock LLM (default), OpenAI, Ollama and similar.
#   For OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...  LLM_MODEL=<model>
#   For Ollama:  LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=<model>
# anthropic: Claude through the Anthropic SDK.
#   LLM_PROVIDER=anthropic  LLM_API_KEY=sk-ant-...  (LLM_MODEL defaults to claude-opus-5-5;
#   LLM_BASE_URL is ignored)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://mock-llm:4001/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000
# Hard cap on LLM calls per UTC day. Every attempt counts, including failed ones.
LLM_DAILY_CAP=2000
LLM_MAX_ATTEMPTS=3
LLM_CONCURRENCY=2
# Changes summarised per LLM call (1-20). Needs a real model; keep 1 for the mock LLM.
LLM_BATCH_SIZE=1
SUMMARY_MAX_AGE_HOURS=48

# --- History -------------------------------------------------------------------------
RETENTION_DAYS=90

LOG_LEVEL=info

# --- Ports on your machine -----------------------------------------------------------
WEB_PORT=8080
API_PORT=3000
DB_PORT=5432
SOURCE_PORT=4002
MOCK_LLM_PORT=4001
